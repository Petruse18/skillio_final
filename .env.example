# Copiază fișierul ăsta ca ".env" și completează cheile. Fișierul .env NU se urcă pe GitHub.
# Fără chei aplicația merge oricum: Gemini trece pe reguli simple, Nokia trece pe simulare.

# Gemini (Google AI Studio -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Nokia Network as Code (developer portal -> Dashboard -> API key)
NOKIA_API_KEY=
# Lasă gol dacă nu ți s-a dat un host anume
NOKIA_RAPIDAPI_HOST=
# Număr de test din sandbox (ex. +99999991000). Dacă e setat, toate apelurile către rețea îl folosesc.
NOKIA_NUMAR_TEST=

# 1 = caută coordonatele adresei pe internet (Nominatim), 0 = folosește centrul cartierului
GEOCODARE=1
# 1 = permite modul de prezentare (?mod=prezentare)
MOD_PREZENTARE=1

# =====================  PRODUCȚIE (toate opționale, vezi PRODUCTIE.md)  =====================

# --- 1. Login securizat (Auth0) ---
# Datele Auth0 se pun în .streamlit/secrets.toml (model: .streamlit/secrets.toml.example).
# DEMO_LOGIN=1: merge și intrarea demo cu numărul de telefon + modul de prezentare. Pe server public: 0.
DEMO_LOGIN=1
# Emailurile care devin admin când intră prin Auth0 (separate prin virgulă)
ADMIN_EMAILS=
SESIUNE_ZILE=30

# --- 2. Baza de date (Tiger Data / PostgreSQL). Gol = SQLite local (data/skillio.db) ---
DATABASE_URL=
# 1 = la o bază goală pune datele demo; 0 = pornește cu baza goală
DATE_DEMO=1

# --- 3. Poze în cloud (Vultr Object Storage). Gol = local, în data/uploads ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- 4. Notificări (email și/sau SMS). Gol = doar în aplicație ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PAROLA=
SMTP_FROM=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- 5. Plăți verificabile pe blockchain (Solana devnet). Gol = plată simulată ---
# Cheia secretă a portofelului platformei (base58 din Phantom sau [..] JSON). Creezi una cu:
#   python -m scripts.solana_portofel
SOLANA_SECRET_KEY=
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Cât SOL înseamnă 1 leu (sume simbolice pe devnet)
SOL_PER_LEU=0.0001

# --- 6. Voce (ElevenLabs). Gol = vocea browserului ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- 7. Server ---
# Adresa publică a aplicației (apare în emailuri)
URL_APP=http://localhost:8501
# Doar pe server: domeniul pentru HTTPS (ex. skillio.duckdns.org)
DOMENIU=
